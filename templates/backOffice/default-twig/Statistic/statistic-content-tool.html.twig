{# Statistics tabs, on the back-office home (hook_home_stats) and on the tool page. Each tab is a
   [data-statistic-panel] drawn by assets/js/statistic.js with the look of the default-twig dashboard. #}
<div class="statistic_tool mb-3" data-testid="statistic-dashboard">
    {% set tabs = hook_block('statistic.tab') %}
    <ul class="nav nav-tabs" role="tablist">
        {% for tab in tabs %}
            <li class="nav-item" role="presentation">
                <a class="nav-link{% if loop.first %} active{% endif %}" id="{{ tab.tab_id }}-tab" href="#{{ tab.tab_id }}"
                   data-bs-toggle="tab" role="tab" aria-controls="{{ tab.tab_id }}"
                   aria-selected="{{ loop.first ? 'true' : 'false' }}" data-testid="statistic-tab-{{ tab.tab_id }}">
                    {{ tab.tab_nav_title }}
                </a>
            </li>
        {% endfor %}
    </ul>

    <div class="tab-content">
        {% for tab in tabs %}
            <div class="tab-pane fade{% if loop.first %} show active{% endif %}" id="{{ tab.tab_id }}" role="tabpanel"
                 aria-labelledby="{{ tab.tab_id }}-tab">
                {{ tab.content|raw }}
            </div>
        {% endfor %}
    </div>
</div>

<script>
    window.baseAdminUrl = "{{ path('admin.home') }}".replace(/\/home$/, '');
</script>

{{ safe_hook('statistic.footer.js') }}
