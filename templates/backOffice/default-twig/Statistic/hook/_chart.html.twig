{# Chart card of a statistics tab, the card of the dashboard revenue trend. Context: panel, placeholder (shown until a
   chart can be drawn). #}
<div class="card shadow-sm border-0 mb-3" data-stat-chart-card data-testid="statistic-{{ panel }}-chart">
    <div class="card-header bg-body-tertiary d-flex flex-wrap gap-2 align-items-center justify-content-between">
        <h2 class="h6 mb-0"><i class="bi bi-graph-up me-2 text-primary" aria-hidden="true"></i><span data-stat-title></span></h2>
        <span class="text-muted small" data-stat-total-wrapper hidden>
            {{ 'tool.total'|trans({}, 'statistic') }}&nbsp;: <span class="fw-semibold text-body" data-stat-total
                                                                 data-testid="statistic-{{ panel }}-total"></span>
        </span>
    </div>
    <div class="card-body">
        <p class="text-muted text-center my-4" data-stat-placeholder>{{ placeholder|default('') }}</p>
        <div class="alert alert-danger mb-0" role="alert" data-stat-error hidden>{{ 'tool.error'|trans({}, 'statistic') }}</div>
        <div class="bo-chart-canvas" style="height: 340px;" data-stat-chart hidden>
            <canvas data-stat-canvas role="img" aria-label="{{ 'tool.chart'|trans({}, 'statistic') }}"></canvas>
        </div>
    </div>
</div>
