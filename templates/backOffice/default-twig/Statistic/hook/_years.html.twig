{# Two years compared by a statistics tab (product, annual). Context: panel, first and second (request parameter names). #}
<div class="input-group input-group-sm w-auto">
    <span class="input-group-text"><i class="bi bi-calendar" aria-hidden="true"></i></span>
    <input type="number" class="form-control" min="2000" max="2999" step="1" required style="width: 6rem;"
           data-stat-param="{{ first }}" data-stat-year="first" aria-label="{{ 'tool.year'|trans({}, 'statistic') }}"
           data-testid="statistic-{{ panel }}-year">
    <input type="number" class="form-control" min="2000" max="2999" step="1" required style="width: 6rem;"
           data-stat-param="{{ second }}" data-stat-year="second" aria-label="{{ 'tool.compared_year'|trans({}, 'statistic') }}"
           data-testid="statistic-{{ panel }}-year2">
</div>
