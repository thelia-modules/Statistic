{# "Statistics by brand" tab: turnover or number of sales of a brand, day by day. #}
{% set partials = '@StatisticModule/backOffice/default-twig/Statistic/hook/' %}
{% set panel = 'brand' %}
<div data-statistic-panel="brand" data-currency="{{ currency }}" data-default-preset="month" data-legend="ghost"
     data-testid="statistic-brand">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <div class="input-group input-group-sm w-auto">
            <select class="form-select" data-stat-param="brandId" data-stat-required data-stat-brand
                    aria-label="{{ 'tool.panel.brand.selectBrand'|trans({}, 'statistic') }}" data-testid="statistic-brand-select">
                <option value="">{{ 'tool.panel.brand.selectBrand'|trans({}, 'statistic') }}</option>
                {% for brand in brands %}<option value="{{ brand.id }}">{{ brand.title }}</option>{% endfor %}
            </select>
            {% include partials ~ '_search-button.html.twig' with {url: path('statistic.brand.search'), target: '[data-stat-brand]',
                title: 'search.brand.title'|trans({}, 'statistic'), placeholder: 'search.brand.placeholder'|trans({}, 'statistic')} only %}
        </div>
    </div>

    <div class="d-flex flex-wrap gap-1 mb-3" role="group" aria-label="{{ 'tool.indicator'|trans({}, 'statistic') }}">
        {% include partials ~ '_indicator.html.twig' with {panel: panel, key: 'turnover', url: path('statistic.tool.brand.turnover'), icon: 'bi-currency-euro',
            label: 'tool.panel.brand.turnover.title'|trans({}, 'statistic'), format: 'currency', active: true} only %}
        {% include partials ~ '_indicator.html.twig' with {panel: panel, key: 'sales', url: path('statistic.tool.brand.sale'), icon: 'bi-credit-card',
            label: 'tool.panel.brand.sale.title'|trans({}, 'statistic')} only %}
    </div>

    {% include partials ~ '_period.html.twig' with {panel: panel, ghost: true} only %}

    {% include partials ~ '_chart.html.twig' with {panel: panel, placeholder: 'tool.panel.brand.selectBrand'|trans({}, 'statistic')} only %}
    {% include partials ~ '_search-modal.html.twig' with {panel: panel} only %}
</div>
