{# "Statistics by product" tab: turnover or number of sales of one product, month by month, for two years. #}
{% set partials = '@StatisticModule/backOffice/default-twig/Statistic/hook/' %}
{% set panel = 'product' %}
<div data-statistic-panel="product" data-currency="{{ currency }}" data-legend="years" data-testid="statistic-product">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex flex-wrap gap-2">
            <div class="input-group input-group-sm w-auto">
                <select class="form-select" data-stat-category aria-label="{{ 'tool.panel.product.selectCategory'|trans({}, 'statistic') }}"
                        data-products-url="{{ path('statistic.tool.product.list') }}" data-testid="statistic-product-category">
                    <option value="">{{ 'tool.panel.product.selectCategory'|trans({}, 'statistic') }}</option>
                    {% for category in categories %}
                        <option value="{{ category.id }}">{{ category.label }}</option>
                    {% endfor %}
                </select>
                {% include partials ~ '_search-button.html.twig' with {url: path('statistic.category.search'), target: '[data-stat-category]',
                    title: 'search.category.title'|trans({}, 'statistic'), placeholder: 'search.category.placeholder'|trans({}, 'statistic')} only %}
            </div>
            <div class="input-group input-group-sm w-auto">
                <select class="form-select" data-stat-param="ref" data-stat-required data-stat-products
                        aria-label="{{ 'tool.panel.product.selectProduct'|trans({}, 'statistic') }}" data-testid="statistic-product-product">
                    <option value="">{{ 'tool.panel.product.selectProduct'|trans({}, 'statistic') }}</option>
                </select>
                {% include partials ~ '_search-button.html.twig' with {url: path('statistic.products.search'), target: '[data-stat-products]',
                    filter: '[data-stat-category]', title: 'search.product.title'|trans({}, 'statistic'),
                    placeholder: 'search.product.placeholder'|trans({}, 'statistic')} only %}
            </div>
        </div>
        {% include partials ~ '_years.html.twig' with {panel: panel, first: 'year', second: 'year2'} only %}
    </div>

    <div class="d-flex flex-wrap gap-1 mb-3" role="group" aria-label="{{ 'tool.indicator'|trans({}, 'statistic') }}">
        {% include partials ~ '_indicator.html.twig' with {panel: panel, key: 'turnover', url: path('statistic.tool.product.turnover'), icon: 'bi-currency-euro',
            label: 'tool.panel.product.turnover.title'|trans({}, 'statistic'), format: 'currency', active: true} only %}
        {% include partials ~ '_indicator.html.twig' with {panel: panel, key: 'sales', url: path('statistic.tool.product.sale'), icon: 'bi-credit-card',
            label: 'tool.panel.product.sale.title'|trans({}, 'statistic')} only %}
    </div>

    {% include partials ~ '_chart.html.twig' with {panel: panel, placeholder: 'tool.panel.product.selectProduct'|trans({}, 'statistic')} only %}
    {% include partials ~ '_search-modal.html.twig' with {panel: panel} only %}
</div>
