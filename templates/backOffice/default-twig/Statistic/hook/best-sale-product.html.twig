<div id="product-best-sales" data-product_id="{{ product_id }}"
     data-label-sold-one="{{ 'product.saleCount.one'|trans({}, 'statistic') }}"
     data-label-sold-other="{{ 'tool.panel.general.bestSales.salesCount'|trans({}, 'statistic') }}"
     data-label-empty="{{ 'product.noSales'|trans({}, 'statistic') }}"
     data-label-error="{{ 'product.loadError'|trans({}, 'statistic') }}"
     data-label-no-combination="{{ 'product.noCombination'|trans({}, 'statistic') }}"
     data-label-periods="{{ [
         'product.period.current'|trans({}, 'statistic'),
         'product.period.previous'|trans({}, 'statistic'),
         'product.period.lastYear'|trans({}, 'statistic'),
     ]|json_encode }}">
    <div class="d-flex justify-content-end mb-3">
        <div class="input-group w-auto">
            <span class="input-group-text">{{ 'tool.from'|trans({}, 'statistic') }}</span>
            <input id="bestSalesStartDate" type="date" class="form-control" aria-label="{{ 'tool.from'|trans({}, 'statistic') }}"/>
            <span class="input-group-text">{{ 'tool.to'|trans({}, 'statistic') }}</span>
            <input id="bestSalesEndDate" type="date" class="form-control" aria-label="{{ 'tool.to'|trans({}, 'statistic') }}"/>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header d-flex align-items-center">
                    <h2 class="h6 mb-0"><i class="bi bi-graph-up me-2 text-primary" aria-hidden="true"></i>{{ 'tool.panel.general.bestSales.sales'|trans({}, 'statistic') }}</h2>
                </div>
                <ul class="list-group list-group-flush small" data-product-best-sales="sales"></ul>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header d-flex align-items-center">
                    <h2 class="h6 mb-0"><i class="bi bi-diagram-3 me-2 text-primary" aria-hidden="true"></i>{{ 'product.byCombination'|trans({}, 'statistic') }}</h2>
                </div>
                <ul class="list-group list-group-flush small" data-product-best-sales="combinations"></ul>
            </div>
        </div>
    </div>
</div>

<script>
    window.baseAdminUrl = "{{ path('admin.home') }}".replace(/\/home$/, '');
</script>
