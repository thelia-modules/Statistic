{# "Annual statistics" tab: the turnover month by month of two years, drawn as soon as the tab shows. #}
{% set partials = '@StatisticModule/backOffice/default-twig/Statistic/hook/' %}
{% set panel = 'annual' %}
<div data-statistic-panel="annual" data-currency="{{ currency }}" data-legend="years" data-testid="statistic-annual">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div class="d-flex flex-wrap gap-1" role="group" aria-label="{{ 'tool.indicator'|trans({}, 'statistic') }}">
            {% include partials ~ '_indicator.html.twig' with {panel: panel, key: 'turnover', url: path('statistic.tool.annual.turnover'), icon: 'bi-currency-euro',
                label: 'tool.panel.general.turnover.title'|trans({}, 'statistic'), format: 'currency', active: true} only %}
        </div>
        {% include partials ~ '_years.html.twig' with {panel: panel, first: 'startYear', second: 'endYear'} only %}
    </div>

    {% include partials ~ '_chart.html.twig' with {panel: panel} only %}
</div>
