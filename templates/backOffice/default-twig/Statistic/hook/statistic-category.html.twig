{# "Statistics by category" tab: turnover or number of sales of a category and its sub-categories, day by day. #}
{% set partials = '@StatisticModule/backOffice/default-twig/Statistic/hook/' %}
{% set panel = 'category' %}
<div data-statistic-panel="category" data-currency="{{ currency }}" data-default-preset="month" data-legend="ghost"
     data-testid="statistic-category">
    <div class="d-flex flex-wrap gap-2 mb-3">
        <div class="input-group input-group-sm w-auto">
            <select class="form-select" data-stat-param="categoryId" data-stat-required data-stat-category
                    aria-label="{{ 'tool.panel.product.selectCategory'|trans({}, 'statistic') }}" data-testid="statistic-category-select">
                <option value="">{{ 'tool.panel.product.selectCategory'|trans({}, 'statistic') }}</option>
                {% for category in categories %}<option value="{{ category.id }}">{{ category.label }}</option>{% endfor %}
            </select>
            {% include partials ~ '_search-button.html.twig' with {url: path('statistic.category.search'), target: '[data-stat-category]',
                title: 'search.category.title'|trans({}, 'statistic'), placeholder: 'search.category.placeholder'|trans({}, 'statistic')} only %}
        </div>
    </div>

    <div class="d-flex flex-wrap gap-1 mb-3" role="group" aria-label="{{ 'tool.indicator'|trans({}, 'statistic') }}">
        {% include partials ~ '_indicator.html.twig' with {panel: panel, key: 'turnover', url: path('statistic.tool.category.turnover'), icon: 'bi-currency-euro',
            label: 'tool.panel.product.turnover.title'|trans({}, 'statistic'), format: 'currency', active: true} only %}
        {% include partials ~ '_indicator.html.twig' with {panel: panel, key: 'sales', url: path('statistic.tool.category.sale'), icon: 'bi-credit-card',
            label: 'tool.panel.product.sale.title'|trans({}, 'statistic')} only %}
    </div>

    {% include partials ~ '_period.html.twig' with {panel: panel, ghost: true} only %}

    {% include partials ~ '_chart.html.twig' with {panel: panel, placeholder: 'tool.panel.product.selectCategory'|trans({}, 'statistic')} only %}
    {% include partials ~ '_search-modal.html.twig' with {panel: panel} only %}
</div>
