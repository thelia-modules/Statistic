{# Statistic dashboard front-end stack. The default-twig BO ships no jQuery; the legacy dashboard
   is built on jQuery + jqplot + DataTables + bootstrap-datepicker. jqplot has no maintained CDN, so
   it is loaded from a pinned CDN mirror; jQuery/DataTables/datepicker likewise. The module's own
   behaviour scripts are served from /assets/modules/statistic/ — Thelia publishes the module's
   templates/backOffice/default-twig/assets/ folder under that URL prefix at activation time. #}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/jqplot/1.0.9/jquery.jqplot.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker3.min.css">
<link rel="stylesheet" href="/assets/modules/statistic/stats.css">

<script>
    if (typeof jQuery === 'undefined') {
        document.write('<script src="https://code.jquery.com/jquery-3.7.1.min.js"><\/script>');
    }
</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqplot/1.0.9/jquery.jqplot.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqplot/1.0.9/plugins/jqplot.highlighter.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqplot/1.0.9/plugins/jqplot.barRenderer.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqplot/1.0.9/plugins/jqplot.pieRenderer.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqplot/1.0.9/plugins/jqplot.canvasTextRenderer.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqplot/1.0.9/plugins/jqplot.dateAxisRenderer.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jqplot/1.0.9/plugins/jqplot.canvasAxisTickRenderer.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/datatables/1.10.21/js/jquery.dataTables.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js"></script>

<script src="/assets/modules/statistic/blocksit.min.js"></script>
<script src="/assets/modules/statistic/modalSearch.js"></script>
<script src="/assets/modules/statistic/statistic.js"></script>
