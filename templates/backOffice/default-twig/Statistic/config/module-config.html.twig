<div class="card">
    <div class="card-header">
        <h3 class="card-title mb-0">{{ 'tool.config.order_types'|trans({}, 'statistic') }}</h3>
    </div>
    <div class="card-body">

        <form method="POST" action="{{ path('statistic.configuration') }}">
            {{ form_widget(configuration_form._token) }}
            {% if configuration_form.vars.errors|length > 0 %}
                <div class="alert alert-danger">{{ form_errors(configuration_form) }}</div>
            {% endif %}

            <div class="mb-3 row">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text"
                               name="{{ configuration_form.order.vars.full_name }}"
                               class="form-control{% if configuration_form.order.vars.errors|length > 0 %} is-invalid{% endif %}"
                               value="{{ configuration_form.order.vars.value }}">
                        <button type="submit" class="btn btn-secondary">{{ 'Set'|trans({}, 'statistic') }}</button>
                    </div>
                    {{ form_errors(configuration_form.order) }}
                </div>
            </div>
            {% do configuration_form.order.setRendered %}
        </form>
        <p class="form-text">{{ 'tool.config.help'|trans({}, 'statistic') }}</p>

        <form method="POST" action="{{ path('statistic.include_shipping') }}">
            {{ form_widget(include_shipping_form._token) }}
            <div class="form-check mb-3">
                <input type="checkbox"
                       class="form-check-input"
                       id="{{ include_shipping_form.include_shipping.vars.id }}"
                       name="{{ include_shipping_form.include_shipping.vars.full_name }}"
                       {% if include_shipping_form.include_shipping.vars.checked %}checked{% endif %}>
                <label class="form-check-label" for="{{ include_shipping_form.include_shipping.vars.id }}">
                    {{ include_shipping_form.include_shipping.vars.label }}
                </label>
            </div>
            {% do include_shipping_form.include_shipping.setRendered %}
            <button type="submit" class="btn btn-success">{{ 'Save'|trans({}, 'statistic') }}</button>
        </form>

        <hr>

        {% set table_rows = [] %}
        {% for status in order_statuses %}
            {% set status_url = '/admin/configuration/order-status/update/' ~ status.id %}
            {% set action_html %}
                {% if is_granted('UPDATE', 'admin.order-status') %}
                    <a title="{{ 'tool.config.edit_order_status'|trans({}, 'statistic') }}"
                       href="{{ status_url }}">
                        <i class="bi bi-pencil"></i>
                    </a>
                {% endif %}
            {% endset %}
            {% set table_rows = table_rows|merge([{
                'id':       '<a href="' ~ status_url ~ '">' ~ status.id|e ~ '</a>',
                'code':     '<a href="' ~ status_url ~ '">' ~ status.code|e ~ '</a>',
                'title':    '<a class="badge text-decoration-none" style="background-color: ' ~ (status.color ? status.color : '#f0ad4e')|e ~ ';" href="' ~ status_url ~ '">' ~ status.title|e ~ '</a>',
                'orders':   '<a href="' ~ path('admin.order.list') ~ '?status=' ~ status.id ~ '">' ~ status.order_count|e ~ '</a>',
                'position': status.position,
                '_action':  action_html,
            }]) %}
        {% endfor %}

        {{ component('BoDataTable', {
            id: 'statistic-order-statuses',
            caption: 'tool.config.order_status'|trans({}, 'statistic'),
            columns: [
                column_html('id',       'tool.config.id'|trans({}, 'statistic')),
                column_html('code',     'tool.config.code'|trans({}, 'statistic')),
                column_html('title',    'tool.config.title'|trans({}, 'statistic')),
                column_html('orders',   'tool.config.order'|trans({}, 'statistic')),
                column_text('position', 'tool.config.position'|trans({}, 'statistic')),
                column_html('_action',  'tool.config.action'|trans({}, 'statistic'), 'end'),
            ],
            rows: table_rows,
            emptyMessage: 'No order status defined.'|trans({}, 'statistic'),
            extraColumnsHeaderHook: 'order-status.table-header',
            extraColumnsHook: 'order-status.table-row',
            rowHookArgs: {'order_status_id': 'id'},
        }) }}
    </div>
</div>
